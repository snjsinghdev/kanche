# Public client configuration, read by Vite at build time (import.meta.env.VITE_*).
# Copy to .env.local (git-ignored) and fill in. Only VITE_* keys reach the bundle, so never put a
# secret here: anything in this file ships to every player. Server secrets live in
# supabase/functions/.env (see supabase/functions/.env.example).

# Supabase project URL and anon (public) key. Phase 6.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry DSN (public by design). Phase 11.
VITE_SENTRY_DSN=

# PostHog project key (public by design). Phase 11. Child mode disables it.
VITE_POSTHOG_KEY=
