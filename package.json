{
  "name": "kanche",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24.22.0",
    "pnpm": "12.11.2"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "turbo run test",
    "build": "turbo run build",
    "budgets": "node tools/budgets/src/cli.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm budgets",
    "e2e": "pnpm --filter @kanche/client e2e",
    "harness": "pnpm --filter @kanche/determinism harness",
    "lab": "node tools/physics-lab/src/cli.ts",
    "dev": "pnpm --filter @kanche/client dev",
    "android:debug": "pnpm --filter @kanche/client android:debug"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/estree": "1.0.9",
    "@types/node": "24.19.2",
    "@typescript-eslint/parser": "8.71.1",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
